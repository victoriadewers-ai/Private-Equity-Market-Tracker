}
function sources(v){
 let h=v.srcs.length?'<ul class="srcl">'+v.srcs.map(s=>`<li><b>${esc(s.title)}</b> · publicado ${esc(s.published)} · corte ${esc(s.asof)} · ${esc(s.region)}${s.pages?` · ${s.pages} pp.`:''}<br><span style="color:var(--sl)">${esc(s.notes)}</span></li>`).join('')+'</ul>':'<div class="kvn">Sin fuentes para este trimestre.</div>';
 if(v.revs.length) h+=`<div class="st" style="margin-top:14px"><span>Revisiones de PitchBook registradas</span><span class="stn">Las vistas anteriores conservan la cifra publicada originalmente</span></div><table class="ctb"><thead><tr><th>Dato</th><th>Publicado originalmente</th><th>Revisado</th><th>Nota</th></tr></thead><tbody>${v.revs.map(r=>`<tr><td>${esc(r[0])}</td><td>${esc(r[1])}</td><td class="v">${esc(r[2])}</td><td>${esc(r[3])}</td></tr>`).join('')}</tbody></table>`;
 h+='<div class="meth">'+DATA.method.map(m=>`<div><b>${esc(m[0])}:</b> ${esc(m[1])}</div>`).join('')+'</div>';
 return h;
}
function render(){
 document.querySelectorAll('.tb').forEach(b=>b.classList.toggle('active',b.dataset.q===Q));
 const k=R+'-'+Q,v=DATA.views[k];
 const ctx=v.srcs.length?`<div class="ctx"><b>${QL[Q]}</b> — fuentes: ${v.srcs.map(s=>esc(s.title)+' (corte '+esc(s.asof)+')').join('; ')}. Cifras tal como se publicaron en el reporte del trimestre.</div>`:'';
 const ban=v.unavailable?'<div class="banner">Reporte del trimestre no incorporado.</div>':'';
 document.getElementById('view').innerHTML=ctx+ban+
  sec('Market Overview',cards(v),'Cifras del trimestre seleccionado')+
  sec('Key Message',keyMsg(v))+
  sec('Entry Multiples',multiples(v,k),'EV/EBITDA de entrada')+
  sec('Direct Lending Issuance',dlSec(v),'Originación de deuda, spreads y leverage')+
  sec('Market Evolution',matrix(),'Solo información disponible hasta el trimestre seleccionado')+
  sec('Market Charts',charts({charts:v.charts.filter(c=>c.id!=='mult'&&c.id!=='dl').concat(v.charts.filter(c=>c.id==='mult'||c.id==='dl'))}),'Series según el reporte del trimestre')+
  sec('Market Developments',devs(v))+
  sec('Investment Implications',imps(v),'Hechos PitchBook vs interpretación IA')+
  sec('Sources & Methodology',sources(v));
 drawAll();
}
/* ---------- charts ---------- */
function axis(mn,mx){mn=Math.min(0,mn);const r=(mx-mn)||1,raw=r/4,mag=Math.pow(10,Math.floor(Math.log10(raw)));const st=[1,2,2.5,5,10].map(f=>f*mag).find(s=>s>=raw);const lo=Math.floor(mn/st)*st,hi=Math.ceil(mx*1.04/st)*st;const t=[];for(let x=lo;x<=hi+1e-9;x+=st)t.push(+x.toFixed(6));return{lo,hi,t,st}}
function fmtV(v,u){if(v==null)return 'N/D';const d=(u==='x'||u==='$B'||u==='€B')?1:0;const s=NF(v,d);return u==='$B'?'$'+s+'B':u==='€B'?'€'+s+'B':u==='x'?s+'x':u==='pb'?s+' pb':s}
function drawAll(){document.querySelectorAll('canvas[data-ch]').forEach(cv=>{const v=DATA.views[R+'-'+Q];const c=v.charts.find(x=>x.id===cv.dataset.ch);if(c&&c.spec)draw(cv,c.spec)})}
function draw(cv,s){
 const wr=cv.parentElement,DPR=window.devicePixelRatio||1,W=Math.max(wr.clientWidth,200),H=210;
 cv.width=W*DPR;cv.height=H*DPR;cv.style.width=W+'px';cv.style.height=H+'px';
 const x=cv.getContext('2d');x.setTransform(DPR,0,0,DPR,0,0);
 const F="'Aller','Segoe UI',Arial,sans-serif",n=s.labels.length,nb=s.bars.length;
 const PL=44,PR=s.line?40:10,PT=14,PB=36,cW=W-PL-PR,cH=H-PT-PB;
 const all=s.bars.flatMap(b=>b.d).filter(v=>v!=null),ax=axis(Math.min(...all),Math.max(...all));
 const yp=v=>PT+cH-((v-ax.lo)/(ax.hi-ax.lo))*cH,gw=cW/n,bw=Math.min(gw*.74/nb,46),off=(gw-bw*nb)/2;
 x.clearRect(0,0,W,H);x.font='9px '+F;
 ax.t.forEach(t=>{const y=yp(t);x.strokeStyle=t===0?'rgba(0,0,0,.18)':'#E6E6E6';x.lineWidth=t===0?1:.6;x.beginPath();x.moveTo(PL,y);x.lineTo(PL+cW,y);x.stroke();x.fillStyle='#000';x.textAlign='right';x.fillText(fmtV(t,s.unit).replace(/,0(?=[Bx]|$)/,''),PL-4,y+3)});
 s.bars.forEach((b,k)=>b.d.forEach((v,i)=>{if(v==null)return;const ytd=s.ytd.includes(i);x.fillStyle=ytd?'#B3D88C':b.c;const bx=PL+i*gw+off+k*bw,y=yp(v),y0=yp(Math.max(0,ax.lo));x.fillRect(bx,Math.min(y,y0),bw-1,Math.abs(y0-y));
  if(n<=12&&nb===1){x.fillStyle='#000';x.textAlign='center';x.font=(nb>1?'8px ':'9px ')+F;x.fillText(fmtV(v,s.unit),bx+bw/2,y-3)}}));
 if(s.line){const lv=s.line.d,la=axis(0,Math.max(...lv)),ly=v=>PT+cH-((v-la.lo)/(la.hi-la.lo))*cH;
  x.strokeStyle=s.line.c;x.lineWidth=2;x.beginPath();lv.forEach((v,i)=>{const px=PL+i*gw+gw/2;i?x.lineTo(px,ly(v)):x.moveTo(px,ly(v))});x.stroke();
  lv.forEach((v,i)=>{x.fillStyle=s.line.c;x.beginPath();x.arc(PL+i*gw+gw/2,ly(v),2.5,0,7);x.fill()});
  x.fillStyle=s.line.c;x.textAlign='left';x.font='9px '+F;la.t.forEach(t=>x.fillText(NF(t,0),PL+cW+4,ly(t)+3))}
 const step=Math.ceil(n/Math.max(1,Math.floor(cW/42)));x.fillStyle='#000';x.font='9px '+F;
 s.labels.forEach((l,i)=>{if(i%step&&i!==n-1)return;x.save();x.translate(PL+i*gw+gw/2,H-PB+12);if(n>12){x.rotate(-Math.PI/5);x.textAlign='right'}else x.textAlign='center';x.fillText(l,0,0);x.restore()});
 cv.onmousemove=e=>{const r=cv.getBoundingClientRect(),mx=e.clientX-r.left;if(mx<PL||mx>PL+cW){hideT();return}const i=Math.min(n-1,Math.floor((mx-PL)/gw));
  let h='<span style="opacity:.65">'+esc(s.labels[i])+(s.ytd.includes(i)?' (YTD)':'')+'</span>';s.bars.forEach(b=>h+='<br><span style="color:'+b.c+'">●</span> '+esc(b.n)+': <b>'+fmtV(b.d[i],s.unit)+'</b>');
  if(s.line)h+='<br><span style="color:'+s.line.c+'">●</span> '+esc(s.line.n)+': <b>'+NF(s.line.d[i],0)+'</b>';showT(e,h)};
 cv.onmouseleave=hideT;
}
/* ---------- events ---------- */
document.querySelectorAll('.tb').forEach(b=>b.onclick=()=>{Q=b.dataset.q;render()});
document.getElementById('olderBtn').onclick=e=>{e.stopPropagation();document.getElementById('olderMenu').classList.toggle('open')};
document.addEventListener('click',e=>{if(!e.target.closest('.older-wrap'))document.getElementById('olderMenu').classList.remove('open')});
document.getElementById('btnManual').onclick=()=>document.getElementById('manModal').classList.add('open');
document.querySelectorAll('.mo').forEach(m=>m.addEventListener('click',e=>{if(e.target===m||e.target.closest('[data-close]'))m.classList.remove('open')}));
document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.mo.open').forEach(m=>m.classList.remove('open'))});
document.getElementById('view').addEventListener('click',e=>{const b=e.target.closest('[data-cell]');if(!b)return;const [q,k]=b.dataset.cell.split('|');const c=DATA.evo[R][q][k],vn=DATA.vars.find(x=>x[0]===k)[1];
 document.getElementById('cmPer').textContent=QL[q];document.getElementById('cmTop').textContent=vn;const bd=document.getElementById('cmBadge');bd.className='badge '+c.t;bd.textContent=c.l;
 const rows=[['Situación del trimestre',c.sit],['Explicación',c.exp],['Cifras relevantes',c.fig],['Cambio respecto del período anterior',c.chg],['Implicancias (interpretación IA)',c.imp],['Fuente y página',c.src||'—']].filter(r=>r[1]&&r[1]!=='—'||r[0]==='Fuente y página');
 document.getElementById('cmBody').innerHTML=rows.map(r=>`<div class="mrow"><div class="k">${r[0]}</div><div class="v">${esc(r[1])}</div></div>`).join('')+`<div class="kvs">Evaluación: ${TL[c.t]}. Etiqueta cualitativa generada por IA.</div>`;
 document.getElementById('cellModal').classList.add('open')});
let rt;addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(drawAll,120)});
render();
</script>
